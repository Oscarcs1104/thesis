*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# datasets + caches are regenerated by data_pipeline/prepare_all.py -- not committed
data/*
!data/zinc15_250K.csv
*.pt
*.pth
*.graphs.*.pt

checkpoints/
wandb/
plots/
